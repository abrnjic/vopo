rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }
    function hasActiveRole(role) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == role
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'active';
    }
    function isAdmin() {
      return hasActiveRole('admin');
    }
    function isReseller() {
      return hasActiveRole('reseller');
    }
    function isSubseller() {
      return hasActiveRole('subseller');
    }
    function isPortalSeller() {
      return isReseller() || isSubseller();
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // USERS kolekcija
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || (isReseller() && resource.data.parentResellerId == request.auth.uid);
      allow create: if false; // Only API
      allow delete: if false; // Only API
      // Dopušteno ažuriranje samo određenih sigurnih polja klijentu:
      allow update: if isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'phoneNumber']);
    }

    // DOMAINS kolekcija
    match /domains/{domainId} {
      allow read: if isAuthenticated();
      allow create: if isReseller() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isReseller() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAdmin();
    }

    // LICENSES kolekcija
    match /licenses/{licenseId} {
      // Samo admini i vlasnici (reselleri) mogu čitati
      allow read: if isAdmin() || (isPortalSeller() && resource.data.resellerId == request.auth.uid);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // DEVICES kolekcija (čisto za svaki slučaj, pristup ide isključivo preko API-ja)
    match /devices/{deviceId} {
      allow read, write: if false;
    }

    // Dijagnostika se čita i zapisuje isključivo kroz autorizirani server API.
    match /device_diagnostics/{deviceId} {
      allow read, write: if false;
    }

    // TRANSACTIONS kolekcija
    match /transactions/{transactionId} {
      allow read: if isAdmin() || (isPortalSeller() && (resource.data.resellerId == request.auth.uid || resource.data.subsellerId == request.auth.uid));
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // AUDIT LOGS kolekcija
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ACTIVITY LOGS kolekcija
    match /activity_logs/{logId} {
      allow read: if isAdmin() || (isPortalSeller() && resource.data.userId == request.auth.uid);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
