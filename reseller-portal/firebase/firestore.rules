rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // USERS kolekcija
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId) || (isAuthenticated() && request.auth.token.role == 'reseller' && resource.data.parentId == request.auth.uid);
      allow create: if false; // Only API
      allow delete: if false; // Only API
      // Dopušteno ažuriranje samo određenih sigurnih polja klijentu:
      allow update: if isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'phoneNumber']);
    }

    // DOMAINS kolekcija
    match /domains/{domainId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.token.role == 'reseller' && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && request.auth.token.role == 'reseller' && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // LICENSES kolekcija
    match /licenses/{licenseId} {
      // Samo admini i vlasnici (reselleri) mogu čitati
      allow read: if isAdmin() || (isAuthenticated() && request.auth.token.role == 'reseller' && resource.data.resellerId == request.auth.uid);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // DEVICES kolekcija (čisto za svaki slučaj, pristup ide isključivo preko API-ja)
    match /devices/{deviceId} {
      allow read, write: if false;
    }

    // TRANSACTIONS kolekcija
    match /transactions/{transactionId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.token.role == 'reseller' && resource.data.resellerId == request.auth.uid);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // AUDIT LOGS kolekcija
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ACTIVITY LOGS kolekcija
    match /activity_logs/{logId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.token.role == 'reseller' && resource.data.userId == request.auth.uid);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
